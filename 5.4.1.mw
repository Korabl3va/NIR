<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart;
interface(typesetting=standard):
with(plots):
ric_rule := diff(Y(z), z) = b - Y(z)^2:
ansatz := A0 + A1*Y(z) + A2*Y(z)^2 + A3*Y(z)^3:
y_z := expand(subs(ric_rule, diff(ansatz, z))):
y_zz := expand(subs(ric_rule, diff(y_z, z))):
y_zzz := expand(subs(ric_rule, diff(y_zz, z))):
ODE := y_zzz + sigma*y_zz + y_z + (1/2)*ansatz^2 - C0*ansatz + C1:
eqs := {seq(coeff(expand(ODE), Y(z), i) = 0, i = 0 .. 6)}:
<Font encoding="UTF-8"># allvalues - \321\200\320\260\321\201\320\277\320\260\320\272\320\276\320\262\321\211\320\270\320\272, \320\264\320\265\320\273\320\260\320\265\321\202 \320\270\320\267 RootOf 2 \321\200\320\265\321\210\320\265\320\275\320\270\321\217
</Font>raw_sols := [solve(eqs union {A3=120}, {A0, A1, A2, A3, b, C1, sigma})]:
all_s := [seq(op([allvalues(s)]), s in raw_sols)]:

<Font encoding="UTF-8"># \320\237\320\276\321\201\321\202\321\200\320\276\320\265\320\275\320\270\320\265
</Font>for k from 1 to nops(all_s) do
<Font encoding="UTF-8"># eval - \320\264\320\276\321\201\321\202\320\260\320\265\320\274 \320\276\320\277\321\200\320\265\320\264\320\265\320\273\320\265\320\275\320\275\321\213\320\271 \320\277\320\260\321\200\320\260\320\274\320\265\321\202\321\200, evalf - \320\277\320\265\321\200\320\265\320\262\320\276\320\264\320\270\320\274 \320\262 \320\264\320\265\321\201\321\217\321\202\320\270\321\207\320\275\320\276\320\265 \321\207\320\270\321\201\320\273\320\276
</Font>    sol := all_s[k]:
    b_v := evalf(eval(b, sol)):
    s_v := evalf(eval(sigma, sol)):
    
    Y_z_func := sqrt(b_v) * tanh(sqrt(b_v) * z):

    if b_v &gt; 0 then
<Font encoding="UTF-8">        # \320\277\321\200\320\270 z -&gt; -infinity (Y -&gt; -sqrt(b))
</Font>        y_inf := eval(A0 + A1*(-sqrt(b_v)) + A2*b_v + A3*(-b_v^(3/2)), sol):
        c0_fix := solve(y_inf = 0, C0):
        
        type_str := &quot;Solitary Wave (a)&quot;:
        z_range := -30 .. 60:
        y_view := DEFAULT:
        clr := blue:
    else
        c0_fix := 0:
        type_str := &quot;Singular Solution (b)&quot;:
        period := evalf(Pi / sqrt(abs(b_v))):
        z_range := -2*period .. 3*period: 
        y_view := -40 .. 40:
        clr := red:
    end if:

    y_final := evalf(subs(C0 = c0_fix, subs(sol, subs(Y(z)=Y_z_func, ansatz)))):

    lprint(&quot;--------------------------------------------------&quot;);
<Font encoding="UTF-8">    printf(&quot;\320\240\320\225\320\250\320\225\320\235\320\230\320\225 \342\204\226%d: sigma = %.3f, b = %.4f\134n&quot;, k, s_v, b_v);
</Font>    
    p := plot(y_final, z = z_range, view = [z_range, y_view], 
              thickness = 2, color = clr, discont = true,
              title = cat(type_str, &quot; (s=&quot;, evalf(s_v, 2), &quot;)&quot;)):
    print(p);
end do:</Text-field>
</Input>
