<Group hide-input="false" labelreference="L1" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart;
interface(typesetting = standard):

ric_rule := diff(Y(z), z) = b - Y(z)^2:
y_ansatz := A0 + A1*Y(z) + A2*Y(z)^2 + A3*Y(z)^3:
<Font encoding="UTF-8"># subs - Substitute - \320\277\320\276\320\264\321\201\321\202\320\260\320\275\320\276\320\262\320\272\320\260, expand - \321\200\320\260\321\201\320\272\321\200\321\213\321\202\320\270\320\265 \321\201\320\272\320\276\320\261\320\276\320\272
</Font>y_z := expand(subs(ric_rule, diff(y_ansatz, z))):
y_zz := expand(subs(ric_rule, diff(y_z, z))):
y_zzz := expand(subs(ric_rule, diff(y_zz, z))):
ODE := y_zzz + sigma*y_zz + y_z + (1/2)*y_ansatz^2 - C0*y_ansatz + C1:
<Font encoding="UTF-8"># coeff - \320\262\321\213\321\202\320\260\321\201\320\272\320\270\320\262\320\260\320\265\321\202 \320\272\320\276\321\215\321\204\321\204\320\270\321\206\320\270\320\265\320\275\321\202 \320\277\321\200\320\270 i-\320\271 \321\201\321\202\320\265\320\277\320\265\320\275\320\270.
</Font>eqs := {seq(coeff(expand(ODE), Y(z), i) = 0, i = 0 .. 6)}:
<Font encoding="UTF-8"># solve(eqs, {\320\277\320\265\321\200\320\265\320\274\320\265\320\275\320\275\321\213\320\265}) - \321\200\320\265\321\210\320\265\320\275\320\270\320\265 \321\201\320\270\321\201\321\202. \320\260\320\273\320\263. \321\203\321\200-\320\271 (seq)
</Font>sols := [solve(eqs, {A0, A1, A2, A3, b, C0, C1, sigma})]:

# nops - number of operands
for i from 1 to nops(sols) do
<Font encoding="UTF-8">    printf(&quot;--- \320\240\320\265\321\210\320\265\320\275\320\270\320\265 \320\275\320\276\320\274\320\265\321\200 %d ---\134n&quot;, i);
</Font>    print(sols[i]);
end do;</Text-field>
</Input>
