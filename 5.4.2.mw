<Group hide-input="false" labelreference="L65" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">R_rules := [
  diff(R(z), z$2) = -6*R(z)^2 + a*R(z) + b,
  (diff(R(z), z))^2  = -4*R(z)^3 + a*R(z)^2 + 2*b*R(z) + c,
  diff(R(z), z$3)  = -12*R(z) * diff(R(z), z) + a * diff(R(z), z),
  diff(R(z), z$4) = -12 * (diff(R(z), z))^2 -12*R(z)*diff(R(z), z$2) +a*diff(R(z), z$2)
]:
</Text-field>
</Input>
</Group>
